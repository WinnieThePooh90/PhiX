# PostgreSQL für Docker Compose (nur DB-Container) oder lokale Postgres-Instanz
# mit gleichen Zugangsdaten wie in docker-compose.yml.

DATABASE_URL="postgresql://noten_user:noten_password@localhost:5432/notenauswertung?schema=public"

# Desktop / Entwicklung: SQLite (Datei). Schema: prisma/sqlite/schema.prisma
# Relativ zum backend/-Arbeitsverzeichnis:
# DATABASE_URL="file:./phix-dev.sqlite"
# Absolut (Beispiel): DATABASE_URL="file:/home/benutzer/.config/PhiX/phix.db"

# HTTP-Port des Backends (Standard 3000)
# PORT=3000

# Nur Electron-Desktop: gebautes Frontend ausliefern (wird von desktop/main.cjs gesetzt)
# PHIX_STANDALONE=1
# PHIX_FRONTEND_DIST=...

# „Herunterfahren“ stoppt den db-Container, wenn neben „backend“ eine docker-compose.yml liegt.
# Nur bei abweichendem Pfad setzen:
# PHIX_COMPOSE_DIR=C:\Pfad\zu\PhiX

# Voller Docker-Stack (Backend im Container): „Herunterfahren“ führt docker compose down aus.
# PHIX_DOCKER_SHUTDOWN=1
# PHIX_COMPOSE_DIR=… (im Compose-File gesetzt, lokal meist nicht nötig)

# CORS: kommagetrennte erlaubte Origins (Standard: lokale Ports 5173, 1990, 3000)
# PHIX_CORS_ORIGINS=http://localhost:5173,http://phix.example.local

# Secure-Cookie nur hinter HTTPS setzen (1 = Cookie-Flag Secure)
# PHIX_COOKIE_SECURE=1
