# Lokaler Betrieb unter Windows (Backend + Vite-Frontend).
# Passt zu docker compose up db (nur Datenbank) oder zu einer lokalen PostgreSQL-Installation
# mit gleichen Zugangsdaten wie in docker-compose.yml.

DATABASE_URL="postgresql://noten_user:noten_password@localhost:5432/notenauswertung?schema=public"

# Optional: Admin-Passwort beim allerersten Start (leere AppUser-Tabelle)
# BOOTSTRAP_ADMIN_PASSWORD=geheim
