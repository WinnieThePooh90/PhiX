generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/** Anmeldung für die App (Passwort nur als bcrypt-Hash). */
model AppUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  crypto   UserCrypto?
  settings UserSettings?
}

/** Persönliche Einstellungen pro Benutzer (1:1 mit AppUser). */
model UserSettings {
  id                   Int     @id @default(autoincrement())
  userId               Int     @unique
  user                 AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  inactivityTimeoutMin Int     @default(5)
  darkMode             Boolean @default(false)
  colorScheme          String  @default("standard")
}

/** DEK-Hüllen (Passwort + Recovery); Klartext-DEK nur in Krypto-Session im RAM. */
model UserCrypto {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cryptoVersion      Int      @default(1)
  kdfSaltPassword    String
  kdfSaltRecovery    String
  dekWrappedPassword String
  dekWrappedRecovery String
  createdAt          DateTime @default(now())
}

/** Globale App-Registrierung (max. 1 Zeile); gilt für alle Benutzer. */
model AppRegistration {
  id             Int      @id @default(1)
  registeredAt   DateTime @default(now())
  registeredBy   String   @default("")
}

model Config {
  id        Int      @id @default(autoincrement())
  year      String
  className String
  subject   String
  hours     Int
  weighting Json
}

model Course {
  id        Int      @id @default(autoincrement())
  year      String
  className String
  subject   String
  hours     Int
  weighting Json
  /** Notensystem: classic = 1–6 wie bisher; points = Punktesystem (Erweiterung) */
  gradeSystem String @default("classic")
  /** Favorit in der linken Navigationsleiste (oben, alphabetisch; unabhängig vom Schuljahres-Filter). */
  isFavorite Boolean @default(false)
  /** Benannte eigene Notenschlüssel: [{ id, name, referenceMaxPoints, bands: [{ g, lo, hi }] }] */
  customGradingKeys Json @default("[]")
  /** Wenn false: Tab „Tests“ im Kurs ausblenden (z. B. keine geschriebenen Tests). */
  testsWritten Boolean @default(true)
  /** Erweiterte Gewichtungsoptionen in Klasse einblenden. */
  advancedWeightingEnabled Boolean @default(false)
  /** Tests zählen zu 50 % in den Schriftlich-Durchschnitt (keine eigene Tests-Gewichtung). */
  testsAsHalfExam Boolean @default(false)
  /** Tests zählen wie mündliche Noten im Mündlich-Durchschnitt (keine eigene Tests-Gewichtung). */
  testsAsOral Boolean @default(false)
  /** x Tests = 1 Klausur: Tests-Gewicht automatisch aus Anzahl Klausuren/Tests. */
  testsPerKlausurEnabled Boolean @default(false)
  testsPerKlausur Int @default(10)
  /** Zwischengespeicherte erweiterte Gewichtung beim Ausschalten des Schalters. */
  advancedWeightingStash Json?
  /** Wenn false: Tab „GFS“ im Kurs ausblenden (keine GFS im Fach). */
  gfsAccepted Boolean @default(true)
  /** Wenn false: Tab „Projekte“ ausblenden, keine Projekte anlegbar. */
  projectsAccepted Boolean @default(false)
  /** Wenn false: Spalte „Note HJ1“ in der Übersicht ausblenden. */
  summaryShowHJ1 Boolean @default(true)
  /** Wenn true: Menüleiste im Tab Projekte eingeklappt (nur Tabellen sichtbar). */
  projectsMetaBarHidden Boolean @default(false)
  /** Wenn true: Eintrag „Klassenlehrer“ im Einstellungsmenü für diesen Kurs. */
  klassenlehrerEnabled Boolean @default(false)
  /** Wenn true: Eintrag „Album“ im Einstellungsmenü für diesen Kurs. */
  albumEnabled Boolean @default(false)
  /** Oberstufe / Kursstufe — steuert u. a. Anzahl mündlicher Bereiche bei Neuanlage. */
  kursstufe Boolean @default(false)
  /** Besitzer (Anmeldename); nur dieser Nutzer bearbeitet den Kurs, außer „admin“ sieht alle. */
  ownerUsername String @default("admin")

  students   Student[]
  exams      Exam[]
  orals      Oral[]
  tests      Test[]
  projects   Project[]
  gfsEntries   GfsEntry[]
  moneyLists        MoneyList[]
  attendanceLists   AttendanceList[]
  collectionLists   CollectionList[]
  notesLists        NotesList[]
  albumPhotos       AlbumPhoto[]

  @@index([ownerUsername])
}

/** Schuljahr in der Schülerverwaltung (z. B. „2026/2027“). */
model SchoolRosterYear {
  id            Int      @id @default(autoincrement())
  label         String
  ownerUsername String   @default("admin")
  createdAt     DateTime @default(now())

  students SchoolRosterStudent[]

  @@unique([ownerUsername, label])
  @@index([ownerUsername])
}

/** Schulweite Stammliste (Klassenstufe 5–13); nicht mit Kurs-Teilnehmern verknüpft. */
model SchoolRosterStudent {
  id         Int      @id @default(autoincrement())
  /** Klassenstufe / Schulstufe (5 … 13) */
  gradeLevel Int
  firstName  String
  lastName   String
  createdAt  DateTime @default(now())

  schoolYearId Int
  schoolYear   SchoolRosterYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId, gradeLevel])
}

model Student {
  id        Int      @id @default(autoincrement())
  frontendId BigInt? @unique
  firstName String
  lastName  String
  /** Stabile, fortlaufende Schülernummer innerhalb des Kurses (Anzeige in Tabellen). */
  studentNumber Int
  /** Manuelle Endnote in der Gesamtübersicht (leer = nicht gesetzt); Dezimalzahl als Text */
  summaryEndNote String @default("")
  /** Manuelle Note Halbjahr 1 (leer = nicht gesetzt); Dezimalzahl als Text */
  summaryHJ1Note String @default("")
  /** Freitext-Notiz in der Gesamtübersicht (aufgeklappter Schüler) */
  summaryNotes String @default("")
  courseId  Int?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  gfsEntries       GfsEntry[]
  moneyListEntries       MoneyListEntry[]
  attendanceListEntries  AttendanceListEntry[]
  collectionListEntries  CollectionListEntry[]
  notesListEntries       NotesListEntry[]
}

model MoneyList {
  id               Int       @id @default(autoincrement())
  subject          String
  amountPerStudent Float
  notes            String    @default("")
  /** ISO-Datum oder verschlüsselter String (enc:v1:…) */
  dueDate          String?
  includeExternal  Boolean   @default(false)
  externalOnly     Boolean   @default(false)
  courseId         Int
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries          MoneyListEntry[]
  createdAt        DateTime @default(now())

  @@index([courseId])
}

model MoneyListEntry {
  id                Int        @id @default(autoincrement())
  paid              Boolean    @default(false)
  studentId         Int?
  student           Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String     @default("")
  externalLastName  String     @default("")
  moneyListId       Int
  moneyList         MoneyList  @relation(fields: [moneyListId], references: [id], onDelete: Cascade)

  @@unique([moneyListId, studentId])
  @@index([moneyListId])
}

model AttendanceList {
  id              Int       @id @default(autoincrement())
  subject         String
  sessionDate     String?
  notes           String    @default("")
  includeExternal Boolean   @default(false)
  externalOnly    Boolean   @default(false)
  courseId        Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries     AttendanceListEntry[]
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model AttendanceListEntry {
  id                Int             @id @default(autoincrement())
  present           Boolean         @default(false)
  studentId         Int?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String          @default("")
  externalLastName  String          @default("")
  attendanceListId  Int
  attendanceList    AttendanceList  @relation(fields: [attendanceListId], references: [id], onDelete: Cascade)

  @@unique([attendanceListId, studentId])
  @@index([attendanceListId])
}

model CollectionList {
  id              Int       @id @default(autoincrement())
  subject         String
  sessionDate     String?
  notes           String    @default("")
  includeExternal Boolean   @default(false)
  externalOnly    Boolean   @default(false)
  courseId        Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries     CollectionListEntry[]
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model CollectionListEntry {
  id                Int             @id @default(autoincrement())
  collected         Boolean         @default(false)
  studentId         Int?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String          @default("")
  externalLastName  String          @default("")
  collectionListId  Int
  collectionList    CollectionList  @relation(fields: [collectionListId], references: [id], onDelete: Cascade)

  @@unique([collectionListId, studentId])
  @@index([collectionListId])
}

model NotesList {
  id              Int       @id @default(autoincrement())
  subject         String
  sessionDate     String?
  notes           String    @default("")
  includeExternal Boolean   @default(false)
  externalOnly    Boolean   @default(false)
  courseId        Int
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries         NotesListEntry[]
  createdAt       DateTime  @default(now())

  @@index([courseId])
}

model NotesListEntry {
  id                Int        @id @default(autoincrement())
  remark            String     @default("")
  studentId         Int?
  student           Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String     @default("")
  externalLastName  String     @default("")
  notesListId       Int
  notesList         NotesList  @relation(fields: [notesListId], references: [id], onDelete: Cascade)

  @@unique([notesListId, studentId])
  @@index([notesListId])
}

model GfsEntry {
  id        Int     @id @default(autoincrement())
  thema     String  @default("")
  art       String  @default("")
  date      String  @default("")
  gehalten  Boolean @default(false)
  halbjahr  String  @default("1")
  note      String  @default("")
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  Int?
  course    Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

/** Kurs-Album: Fotos mit Titel und Beschreibung (Bilddaten verschlüsselt als Base64-String). */
model AlbumPhoto {
  id          Int      @id @default(autoincrement())
  title       String   @default("")
  description String   @default("")
  mimeType    String   @default("image/jpeg")
  imageData   String   @default("")
  sortOrder   Int      @default(0)
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model Exam {
  id             Int      @id @default(autoincrement())
  examNumber     Int
  active         Boolean
  maxPoints      Float
  numFields      Int
  fieldMaxPoints Json
  keyType        String
  date           String   @default("")
  halbjahr       String   @default("1")
  name           String
  scores         Json
  courseId       Int?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Oral {
  id          Int      @id @default(autoincrement())
  oralNumber  Int
  active      Boolean  @default(true)
  name        String
  date        String   @default("")
  halbjahr    String   @default("1")
  extended    Boolean  @default(false)
  weekCount   Int      @default(0)
  /** Datum jeder Woche als JSON-Array von Strings ["2026-05-25", ...] */
  weekDates   Json     @default("[]")
  /** Beste erreichbare Note (erweitert): 1, 1.25, 1.5, 1.75, 2 */
  bestNote    Float    @default(1)
  /** Schlechteste Note (erweitert): 4 … 6 in 0,25-Schritten */
  worstNote   Float    @default(6)
  /** Streuung 0–1 (Schritt 0,1) für Wochen-/Berechnungslogik */
  weekSpread  Float    @default(0.5)
  grades      Json
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Test {
  id         Int      @id @default(autoincrement())
  testNumber Int
  active     Boolean
  /** Maximale Punktzahl des Tests (Nenner für den Notenschlüssel, wie Klausur-Maximum). */
  maxPoints  Float    @default(10)
  keyType    String
  date       String   @default("")
  halbjahr   String   @default("1")
  name       String
  /** Pro Schüler: erreichte Punkte (Text/Zahl) + optional _counted, _nachschreiber — wie Klausur-Scores. */
  scores     Json
  courseId   Int?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Project {
  id             Int      @id @default(autoincrement())
  projectNumber  Int
  active         Boolean
  name           String
  description    String   @default("")
  /** written = schriftlicher Anteil; oral = mündlicher Anteil; percent = direkter Prozentanteil an der Endnote */
  weightingMode  String   @default("written")
  /** Bei weightingMode percent: Anteil an der Endnote in Prozent (z. B. 20).
   *  Bei written/oral: Anteil an einer Klausur bzw. mündlichen Note (100 = volle Note). */
  weightPercent  Float    @default(0)
  maxPoints      Float
  numFields      Int      @default(0)
  fieldMaxPoints Json
  /** Anzeigenamen der Themenfelder: { "0": "Recherche", "1": "Präsentation", … } */
  fieldNames     Json     @default("{}")
  /** key = Note aus Notenschlüssel; manual = Note nur per Hand in der Tabelle */
  gradeMode      String   @default("key")
  /** individual = Einzelnoten pro Schüler; group = eine Note pro Gruppe */
  gradeScope     String   @default("individual")
  /** Bei gradeScope group: { "1": { "name": "…", "studentIds": [1,2] }, … } */
  groups         Json     @default("{}")
  keyType        String
  date           String   @default("")
  halbjahr       String   @default("1")
  scores         Json
  courseId       Int?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
