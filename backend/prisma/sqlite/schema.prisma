// SQLite-Variante — Modelle müssen mit prisma/schema.prisma (Postgres) synchron gehalten werden.
// Generate: npx prisma generate --schema=prisma/sqlite/schema.prisma
// Push:     npx prisma db push --schema=prisma/sqlite/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  settings UserSettings?

  crypto UserCrypto?
}

model UserCrypto {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  user               AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cryptoVersion      Int      @default(1)
  kdfSaltPassword    String
  kdfSaltRecovery    String
  dekWrappedPassword String
  dekWrappedRecovery String
  createdAt          DateTime @default(now())
}

model UserSettings {
  id                   Int     @id @default(autoincrement())
  userId               Int     @unique
  user                 AppUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  inactivityTimeoutMin Int     @default(5)
  darkMode             Boolean @default(false)
  colorScheme          String  @default("standard")
}

model AppRegistration {
  id             Int      @id @default(1)
  registeredAt   DateTime @default(now())
  registeredBy   String   @default("")
}

model Config {
  id        Int      @id @default(autoincrement())
  year      String
  className String
  subject   String
  hours     Int
  weighting Json
}

model Course {
  id        Int      @id @default(autoincrement())
  year      String
  className String
  subject   String
  hours     Int
  weighting Json
  gradeSystem String @default("classic")
  isFavorite Boolean @default(false)
  customGradingKeys Json @default("[]")
  testsWritten Boolean @default(true)
  advancedWeightingEnabled Boolean @default(false)
  testsAsHalfExam Boolean @default(false)
  testsAsOral Boolean @default(false)
  testsPerKlausurEnabled Boolean @default(false)
  testsPerKlausur Int @default(10)
  advancedWeightingStash Json?
  gfsAccepted Boolean @default(true)
  projectsAccepted Boolean @default(false)
  /** Wenn true: Tab „Referate“; gehaltene Referate optional schriftlich wie Klausuren. */
  referateAccepted Boolean @default(false)
  referatAsExam Boolean @default(false)
  referatAsOral Boolean @default(false)
  referatWrittenPercentEnabled Boolean @default(false)
  referatWrittenPercent Int @default(100)
  referatOralPercentEnabled Boolean @default(false)
  referatOralPercent Int @default(100)
  referatFinalPercentEnabled Boolean @default(false)
  referatFinalPercent Int @default(100)
  /** Wenn false: Spalte „Note HJ1“ in der Übersicht ausblenden. */
  summaryShowHJ1 Boolean @default(true)
  projectsMetaBarHidden Boolean @default(false)
  klassenlehrerEnabled Boolean @default(false)
  albumEnabled Boolean @default(false)
  kursstufe Boolean @default(false)
  ownerUsername String @default("admin")

  students   Student[]
  exams      Exam[]
  orals      Oral[]
  tests      Test[]
  projects   Project[]
  gfsEntries   GfsEntry[]
  referatEntries ReferatEntry[]
  moneyLists        MoneyList[]
  attendanceLists   AttendanceList[]
  collectionLists   CollectionList[]
  notesLists        NotesList[]
  albumPhotos       AlbumPhoto[]

  @@index([ownerUsername])
}

model SchoolRosterYear {
  id            Int      @id @default(autoincrement())
  label         String
  ownerUsername String   @default("admin")
  createdAt     DateTime @default(now())

  students SchoolRosterStudent[]

  @@unique([ownerUsername, label])
  @@index([ownerUsername])
}

model SchoolRosterStudent {
  id         Int      @id @default(autoincrement())
  gradeLevel Int
  firstName  String
  lastName   String
  createdAt  DateTime @default(now())

  schoolYearId Int
  schoolYear   SchoolRosterYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)

  @@index([schoolYearId, gradeLevel])
}

model Student {
  id        Int      @id @default(autoincrement())
  frontendId BigInt? @unique
  firstName String
  lastName  String
  studentNumber Int
  summaryEndNote String @default("")
  summaryHJ1Note String @default("")
  summaryNotes String @default("")
  courseId  Int?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  gfsEntries       GfsEntry[]
  referatEntries   ReferatEntry[]
  moneyListEntries       MoneyListEntry[]
  attendanceListEntries  AttendanceListEntry[]
  collectionListEntries  CollectionListEntry[]
  notesListEntries       NotesListEntry[]
}

model MoneyList {
  id               Int       @id @default(autoincrement())
  subject          String
  amountPerStudent Float
  notes            String    @default("")
  dueDate          String?
  includeExternal  Boolean   @default(false)
  externalOnly     Boolean   @default(false)
  courseId         Int
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries          MoneyListEntry[]
  createdAt        DateTime @default(now())

  @@index([courseId])
}

model MoneyListEntry {
  id                Int        @id @default(autoincrement())
  paid              Boolean    @default(false)
  studentId         Int?
  student           Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String     @default("")
  externalLastName  String     @default("")
  moneyListId       Int
  moneyList         MoneyList  @relation(fields: [moneyListId], references: [id], onDelete: Cascade)

  @@unique([moneyListId, studentId])
  @@index([moneyListId])
}

model AttendanceList {
  id              Int       @id @default(autoincrement())
  subject         String
  sessionDate     String?
  notes           String    @default("")
  includeExternal Boolean   @default(false)
  externalOnly    Boolean   @default(false)
  courseId        Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries     AttendanceListEntry[]
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model AttendanceListEntry {
  id                Int             @id @default(autoincrement())
  present           Boolean         @default(false)
  studentId         Int?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String          @default("")
  externalLastName  String          @default("")
  attendanceListId  Int
  attendanceList    AttendanceList  @relation(fields: [attendanceListId], references: [id], onDelete: Cascade)

  @@unique([attendanceListId, studentId])
  @@index([attendanceListId])
}

model CollectionList {
  id              Int       @id @default(autoincrement())
  subject         String
  sessionDate     String?
  notes           String    @default("")
  includeExternal Boolean   @default(false)
  externalOnly    Boolean   @default(false)
  courseId        Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries     CollectionListEntry[]
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model CollectionListEntry {
  id                Int             @id @default(autoincrement())
  collected         Boolean         @default(false)
  studentId         Int?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String          @default("")
  externalLastName  String          @default("")
  collectionListId  Int
  collectionList    CollectionList  @relation(fields: [collectionListId], references: [id], onDelete: Cascade)

  @@unique([collectionListId, studentId])
  @@index([collectionListId])
}

model NotesList {
  id              Int       @id @default(autoincrement())
  subject         String
  sessionDate     String?
  notes           String    @default("")
  includeExternal Boolean   @default(false)
  externalOnly    Boolean   @default(false)
  courseId        Int
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  entries         NotesListEntry[]
  createdAt       DateTime  @default(now())

  @@index([courseId])
}

model NotesListEntry {
  id                Int        @id @default(autoincrement())
  remark            String     @default("")
  studentId         Int?
  student           Student?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  externalFirstName String     @default("")
  externalLastName  String     @default("")
  notesListId       Int
  notesList         NotesList  @relation(fields: [notesListId], references: [id], onDelete: Cascade)

  @@unique([notesListId, studentId])
  @@index([notesListId])
}

model GfsEntry {
  id        Int     @id @default(autoincrement())
  thema     String  @default("")
  art       String  @default("")
  date      String  @default("")
  gehalten  Boolean @default(false)
  halbjahr  String  @default("1")
  note      String  @default("")
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  Int?
  course    Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ReferatEntry {
  id        Int     @id @default(autoincrement())
  thema     String  @default("")
  art       String  @default("")
  date      String  @default("")
  gehalten  Boolean @default(false)
  halbjahr  String  @default("1")
  note      String  @default("")
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  Int?
  course    Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model AlbumPhoto {
  id          Int      @id @default(autoincrement())
  title       String   @default("")
  description String   @default("")
  mimeType    String   @default("image/jpeg")
  imageData   String   @default("")
  sortOrder   Int      @default(0)
  courseId    Int
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([courseId])
}

model Exam {
  id             Int      @id @default(autoincrement())
  examNumber     Int
  active         Boolean
  maxPoints      Float
  numFields      Int
  fieldMaxPoints Json
  keyType        String
  date           String   @default("")
  halbjahr       String   @default("1")
  name           String
  scores         Json
  courseId       Int?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Oral {
  id          Int      @id @default(autoincrement())
  oralNumber  Int
  active      Boolean  @default(true)
  name        String
  date        String   @default("")
  halbjahr    String   @default("1")
  extendedMode String @default("off")
  weekCount   Int      @default(0)
  weekDates   Json     @default("[]")
  bestNote    Float    @default(1)
  worstNote   Float    @default(6)
  weekSpread  Float    @default(0.5)
  grades      Json
  courseId    Int?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Test {
  id         Int      @id @default(autoincrement())
  testNumber Int
  active     Boolean
  maxPoints  Float    @default(10)
  keyType    String
  date       String   @default("")
  halbjahr   String   @default("1")
  name       String
  scores     Json
  courseId   Int?
  course     Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Project {
  id             Int      @id @default(autoincrement())
  projectNumber  Int
  active         Boolean
  name           String
  description    String   @default("")
  weightingMode  String   @default("written")
  /** percent: Endnoten-Anteil; written/oral: Anteil an Klausur bzw. mündlicher Note (100 = volle Note). */
  weightPercent  Float    @default(0)
  maxPoints      Float
  numFields      Int      @default(0)
  fieldMaxPoints Json
  fieldNames     Json     @default("{}")
  gradeMode      String   @default("key")
  gradeScope     String   @default("individual")
  groups         Json     @default("{}")
  keyType        String
  date           String   @default("")
  halbjahr       String   @default("1")
  scores         Json
  courseId       Int?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
