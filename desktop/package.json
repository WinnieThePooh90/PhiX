{
  "name": "phix-desktop",
  "private": true,
  "version": "475.0.0",
  "description": "PhiX Desktop-Hülle (Electron) – startet das Node-Backend und zeigt die Web-UI.",
  "author": "Karsten Paulokat",
  "license": "Apache-2.0",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ELECTRON_DEV_SERVER=http://127.0.0.1:5173 electron .",
    "build-icon": "node scripts/build-icon.js",
    "prepare-pack": "node scripts/prepare-pack.js",
    "stage-backend": "node scripts/stage-backend-for-pack.js",
    "check-backend": "node scripts/check-backend-for-pack.js",
    "verify-pack": "node scripts/verify-pack-backend.js",
    "install-deps": "node scripts/install-deps.js",
    "dist": "npm run build-icon && npm run prepare-pack && npm run stage-backend && npm run check-backend && electron-builder --config electron-builder.config.cjs --win zip portable",
    "dist:dir": "npm run build-icon && npm run prepare-pack && npm run stage-backend && npm run check-backend && electron-builder --config electron-builder.config.cjs --dir"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "cross-env": "^7.0.3",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "overrides": {
    "tar": "^7.5.16",
    "rimraf": "^6.1.3",
    "glob": "^13.0.6",
    "global-agent": "^4.1.3",
    "undici": "^7.28.0",
    "form-data": "^4.0.5",
    "js-yaml": "^4.1.2"
  },
  "build": {
    "appId": "de.equiphi.phix.desktop",
    "productName": "PhiX",
    "icon": "build/icon.png",
    "copyright": "Copyright © 2026 Karsten Paulokat — Licensed under Apache-2.0",
    "directories": {
      "output": "dist-pack"
    },
    "files": [
      "main.cjs",
      "package.json",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        "zip",
        "portable"
      ],
      "artifactName": "${productName}-Desktop-${version}-${os}-${arch}.${ext}"
    }
  }
}
